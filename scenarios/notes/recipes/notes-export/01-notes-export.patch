From e2fdfa90f72ecbfdd13dc7fed10057f816665331 Mon Sep 17 00:00:00 2001
From: Lukas Novak <lukas.novak@example.com>
Date: Tue, 20 Oct 2026 17:20:00 +0000
Subject: [PATCH] feat: export all of a caller's notes as a download

GET /v1/notes/export returns the caller's notes as one JSON array with a Content-Disposition header.
---
 api/export.go      | 23 +++++++++++++++++++++++
 api/export_test.go | 37 +++++++++++++++++++++++++++++++++++++
 api/server.go      |  1 +
 3 files changed, 61 insertions(+)
 create mode 100644 api/export.go
 create mode 100644 api/export_test.go

diff --git a/api/export.go b/api/export.go
new file mode 100644
index 0000000..c8d7db7
--- /dev/null
+++ b/api/export.go
@@ -0,0 +1,23 @@
+package api
+
+import (
+	"net/http"
+
+	"github.com/aalvaropc/upkeep-sample/middleware"
+	"github.com/aalvaropc/upkeep-sample/notes"
+)
+
+func (s *Server) exportNotes(w http.ResponseWriter, r *http.Request) {
+	owner, ok := middleware.SubjectFrom(r.Context())
+	if !ok {
+		writeError(w, errUnauthenticated)
+		return
+	}
+	list, err := s.notes.List(r.Context(), owner, notes.Page{Limit: notes.MaxPageSize})
+	if err != nil {
+		writeError(w, err)
+		return
+	}
+	w.Header().Set("Content-Disposition", `attachment; filename="notes.json"`)
+	writeJSON(w, http.StatusOK, list.Notes)
+}
diff --git a/api/export_test.go b/api/export_test.go
new file mode 100644
index 0000000..852272f
--- /dev/null
+++ b/api/export_test.go
@@ -0,0 +1,37 @@
+package api
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestExportReturnsTheCallersNotes(t *testing.T) {
+	c := newClient(t)
+	writer := c.token("alice", WriteScope)
+	for _, title := range []string{"first", "second"} {
+		resp, body := c.do(http.MethodPost, "/v1/notes", writer, `{"title":"`+title+`"}`)
+		if resp.StatusCode != http.StatusCreated {
+			t.Fatalf("create %s: %d %s", title, resp.StatusCode, body)
+		}
+	}
+	resp, body := c.do(http.MethodGet, "/v1/notes/export", writer, "")
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("export: %d %s", resp.StatusCode, body)
+	}
+	if got := resp.Header.Get("Content-Disposition"); !strings.Contains(got, "notes.json") {
+		t.Fatalf("Content-Disposition = %q", got)
+	}
+	exported := decode[[]map[string]any](t, body)
+	if len(exported) != 2 {
+		t.Fatalf("exported %d notes, want 2: %s", len(exported), body)
+	}
+}
+
+func TestExportNeedsAToken(t *testing.T) {
+	c := newClient(t)
+	resp, _ := c.do(http.MethodGet, "/v1/notes/export", "", "")
+	if resp.StatusCode != http.StatusUnauthorized {
+		t.Fatalf("status = %d, want 401", resp.StatusCode)
+	}
+}
diff --git a/api/server.go b/api/server.go
index 95b5159..3b7e04a 100644
--- a/api/server.go
+++ b/api/server.go
@@ -20,6 +20,7 @@ func NewServer(svc *notes.Service, authn *middleware.Authenticator) http.Handler
 	mux := http.NewServeMux()
 	mux.HandleFunc("GET /healthz", s.healthz)
 	mux.Handle("GET /v1/notes", s.authn.RequireAuth(http.HandlerFunc(s.listNotes)))
+	mux.Handle("GET /v1/notes/export", s.authn.RequireAuth(http.HandlerFunc(s.exportNotes)))
 	mux.Handle("POST /v1/notes", s.writer(s.createNote))
 	mux.Handle("GET /v1/notes/{id}", s.authn.RequireAuth(http.HandlerFunc(s.getNote)))
 	mux.Handle("PUT /v1/notes/{id}", s.writer(s.updateNote))
